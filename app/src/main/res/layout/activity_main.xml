<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Une bulle flottante s'affiche par-dessus ton appli de lecture. Touche-la : l'écran est lu, le texte est traduit et posé par-dessus les bulles d'origine.\n\n• Toucher la bulle : traduire\n• Appui long : effacer la traduction\n• Glisser : déplacer la bulle"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Langue du manhwa"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <Spinner
            android:id="@+id/sourceSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Traduire vers"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <Spinner
            android:id="@+id/targetSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Moteur de traduction"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <RadioGroup
            android:id="@+id/engineGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/engineMlkit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hors-ligne (ML Kit) : rapide, sans compte, plus littéral" />

            <RadioButton
                android:id="@+id/engineGemini"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="IA Gemini (en ligne) : traduction naturelle, clé gratuite" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/geminiSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Clé API Gemini"
                app:endIconMode="password_toggle"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/geminiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Modèle Gemini">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/geminiModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/geminiKeyButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Obtenir une clé gratuite (Google AI Studio)" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="La capture de l'écran et les textes sont envoyés à Google pour être traduits. Avec la clé gratuite, Google peut s'en servir pour améliorer ses modèles."
                android:textAppearance="?attr/textAppearanceBodySmall" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/followScrollSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Les traductions suivent la page quand je fais défiler" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/autoModeSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mode auto : retraduire dès que l'écran s'arrête" />

        <TextView
            android:id="@+id/deadZoneLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <com.google.android.material.slider.Slider
            android:id="@+id/deadZoneSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:valueFrom="0"
            android:valueTo="25" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bandeau du bas de l'écran (juste au-dessus des boutons Android) où le texte n'est pas traduit : évite les boutons « Chapitre précédent / suivant » des sites."
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <TextView
            android:id="@+id/overlayStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/overlayButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Autoriser l'affichage par-dessus les applis" />

        <TextView
            android:id="@+id/accessStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/accessButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activer le défilement à travers les traductions" />

        <TextView
            android:id="@+id/accessHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dans Accessibilité → Applis installées → Manhwa Traducteur, active le service. S'il est grisé (Android 13+ pour les applis installées hors Play Store) : Paramètres → Applis → Manhwa Traducteur → menu ⋮ en haut à droite → « Autoriser les paramètres restreints », puis réessaie.

Le service ne lit pas l'écran et ne fait aucune action : il sert seulement à laisser passer tes glissements à travers les traductions."
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:text="Démarrer" />
    </LinearLayout>
</ScrollView>
